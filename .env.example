# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. See docs/CONTEXT.md for the architecture these variables plug into.

# --- database --------------------------------------------------------------------
# Credentials docker-compose.yml uses to initialize the `db` container. Keep these
# three in sync with DATABASE_URL below if you change any of them.
POSTGRES_USER=aagp
POSTGRES_PASSWORD=aagp_dev_password
POSTGRES_DB=aagp

# SQLAlchemy connection string the backend reads to connect to Postgres. Matches
# the POSTGRES_* values above and the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://aagp:aagp_dev_password@localhost:5432/aagp

# --- governance --------------------------------------------------------------------
# stub: canned opinions, zero LLM calls, safe default for everyone but the
# governance lane. cached: real Gemini responses replayed from recorded fixtures
# (the demo default). live: real Gemini API calls behind a flag, with a timeout
# and automatic fallback to cached. See docs/lanes/vc.md.
GOVERNANCE_MODE=stub

# Google AI Studio API key for Gemini. Only read in `live` mode — leave blank for
# stub/cached, and the project must run end-to-end with it blank. Never commit a
# real key; it belongs in your local .env only.
GEMINI_API_KEY=

# --- logging -------------------------------------------------------------------------
# Standard Python logging level for the backend and governance lane.
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- frontend ------------------------------------------------------------------------
# Base URL the frontend's generated API client points at. Matches the backend
# dev server's port (see `make dev`).
API_BASE_URL=http://localhost:8000
